  "worldEventOutcomes": {
    "roadside-ambush": "账房失踪，主角负伤抵达城门。"
  },
  "dialogue": [
    {
      "id": "line-1788510233141-0",
      "speaker": "旁白",
      "text": "雨水冲淡了荒道上的血。你醒来时，同行者已经失散，路引和部分财物不知所踪。左肋的伤口仍在渗血。",
      "kind": "narration"
    },
    {
      "id": "line-1788510233141-1",
      "speaker": "旁白",
      "text": "昏沉中，你只记得袭击者反复喊着一句：“找丁字十七。”暮鼓将响，青石县是天黑前唯一能赶到的避处。",
      "kind": "narration"
    },
    {
      "id": "line-1788510233141-2",
      "speaker": "旁白",
      "text": "你拖着湿透的行囊来到城门，雨云正压过斑驳城楼。",
      "kind": "narration"
    },
    {
      "id": "line-1788510233141-3",
      "speaker": "旁白",
      "text": "一个脸颊带刀疤的差役拦在道中，手始终没有离开腰间铁尺。",
      "kind": "narration"
    },
    {
      "id": "line-1788510233141-4",
      "speaker": "腰挂铁尺的守门差役",
      "text": "“站住。路引拿出来。哪里人，来青石县做什么？”",
      "kind": "npc"
    }
  ],
  "logs": [
    {
      "id": "log-1788510233141-5",
      "atMinutes": 5340,
      "type": "system",
      "text": "旧档测试客在荒道遇袭后抵达青石县城门。"
    }
  ]
