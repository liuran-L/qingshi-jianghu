{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "青石江湖",
  "version": "0.1.0",
  "identifier": "com.qingshi.jianghu",
  "build": {
    "beforeDevCommand": "npm run desktop:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "青石江湖",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"]
  }
}
